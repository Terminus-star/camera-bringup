--- a/drivers/media/platform/amd/isp4/isp4_debug.c
+++ b/drivers/media/platform/amd/isp4/isp4_debug.c
@@ -107,7 +107,7 @@
 					*le = 0;
 
 				if (*str != '\0')
-					dev_dbg(isp->dev, "%s", str);
+					dev_info(isp->dev, "EXP-FWLOG: %s", str);
 
 				if (le) {
 					*le = 0x0A;
@@ -120,13 +120,31 @@
 
 				temp_ch = str[tmp_len];
 				str[tmp_len] = 0;
-				dev_dbg(isp->dev, "%s", str);
+				dev_info(isp->dev, "EXP-FWLOG: %s", str);
