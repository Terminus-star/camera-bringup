# Kbuild wrapper for the DKMS package amd-isp4-capture.
#
# kbuild reads this file (it takes precedence over the Makefile next to it)
# when called as   make -C <kernel build dir> M=<this directory> modules
#
# It does NOT list the objects itself: it includes driver/Kbuild, so the
# object list stays in one place.  The sources are found in one of two layouts:
#
#   repository:     dkms/Kbuild   + ../driver/{*.c,*.h,Kbuild}
#   DKMS tree:      <pkg>/Kbuild  +    driver/{*.c,*.h,Kbuild}
#                   (/usr/src/amd-isp4-capture-<ver>/, copied by the
#                    commands that dkms/install.sh prints)
#
# Object files are always written next to this file (the M= directory), never
# into driver/.
#
# How the sources are found: since Linux 6.13 the kbuild compile rule is
# "$(obj)/%.o: $(obj)/%.c" and the source is located through make's directory
# search (kbuild sets VPATH to the M= directory).  The "vpath %.c" line below
# adds driver/ to that search for .c files only.  It is deliberately NOT a
# plain VPATH: driver/ also holds stale build output (.o, .cmd, Module.symvers)
# from scripts/build-isp4-threshold.sh, and make must not pick those up.
# Older kbuild (before 6.13) used "$(src)/%.c" and would ignore vpath; that is
# below this module's minimum kernel anyway (see README.md).

isp4-srcdir := $(if $(wildcard $(src)/driver/Kbuild),$(src)/driver,$(abspath $(src)/../driver))

ifeq ($(wildcard $(isp4-srcdir)/Kbuild),)
$(error amd-isp4-capture: driver sources not found (looked in $(src)/driver and $(src)/../driver))
endif

# obj-m and amd_isp4_capture-objs come from here.
include $(isp4-srcdir)/Kbuild

vpath %.c $(isp4-srcdir)

# Since driver patch 0037 the sources no longer include the three generated headers: the device
# script, sensor properties and D-PHY sequence are loaded at run time from /lib/firmware/amdgpu/
# (gz302-ov13b-*.bin), so nothing Windows-derived is needed to build.  check-generated-headers.sh
# only warns when those firmware files are missing on this machine.
