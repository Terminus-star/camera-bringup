From: GZ302 camera enablement <local@termis>
Subject: [PATCH] drm/amdgpu: map GZ302 OV13B10 reset GPIO

The OV13B10 probe reaches the I2C identification transaction but returns
-EIO. Firmware supplies no GPIO descriptors. The ISP reference platform
uses amdisp-pinctrl GPIO 0 for its sensor enable; map that existing physical
sensor control to OV13B10's reset descriptor so its standard power sequence
can release the sensor before I2C access.

---
diff --git a/drivers/gpu/drm/amd/amdgpu/isp_v4_1_1.c b/drivers/gpu/drm/amd/amdgpu/isp_v4_1_1.c
--- a/drivers/gpu/drm/amd/amdgpu/isp_v4_1_1.c
+++ b/drivers/gpu/drm/amd/amdgpu/isp_v4_1_1.c
@@ -65,6 +65,14 @@
 	},
 };
 
+static struct gpiod_lookup_table isp_ov13b10_sensor_gpio_table = {
+	.dev_id = "i2c-ov13b10",
+	.table = {
+		GPIO_LOOKUP("amdisp-pinctrl", 0, "reset", GPIO_ACTIVE_LOW),
+		{ }
+	},
+};
+
 static int isp_poweroff(struct generic_pm_domain *genpd)
 {
 	struct amdgpu_isp *isp = container_of(genpd, struct amdgpu_isp, ispgpd);
@@ -249,6 +257,10 @@
 		gpiod_add_lookup_table(&isp_sensor_gpio_table);
 	}
 
+if (!strcmp("OMNI13B1", acpi_device_hid(acpi_dev))) {
+		gpiod_add_lookup_table(&isp_ov13b10_sensor_gpio_table);
+	}
+
 	isp_base = adev->rmmio_base;
 
 	isp->ispgpd.name = "ISP_v_4_1_1";
